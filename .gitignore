# ---------------------------------------------------------------------------
# Anonymized replication package for peer review.
# Ship the code and only the compact inputs that code/starlink_results.Rmd
# actually reads. Everything else stays local.
# ---------------------------------------------------------------------------

# --- manuscript ------------------------------------------------------------
# Excluded in full: the manuscript is submitted through the journal, not here,
# and the LaTeX source is not anonymized.
manuscript/

# --- data ------------------------------------------------------------------
# Default-deny, then re-include the exact files the results document reads.
# Raw provider downloads are listed in README.md with URLs and access dates;
# they are public, large, and not committed.
data/*
!data/cmdty_price_anonormal.RDS
!data/cmdty_price_monthly.RDS
!data/dataset_normalyr.RDS
!data/dataset_prodesyr.RDS
!data/prodes_source.txt

!data/processed/
data/processed/*
!data/processed/figure1_mobile_coverage.RDS
!data/processed/figure_ax_deter_fire_2021_2024.RDS
!data/processed/mun_zone.RDS
!data/processed/spei12_copernicus_era5_normalyr.RDS
!data/processed/spei12_copernicus_era5_prodesyr.RDS

# --- code ------------------------------------------------------------------
# Local audit script: hard-codes an absolute path that identifies the author.
code/audit_v3_prodes.R
code/Rplots.pdf

# Rendered output. Large, and regenerated by knitting the Rmd.
code/*.html
code/*_files/
code/*_cache/

# --- R session -------------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
